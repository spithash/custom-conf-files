# ============================================================
# GRC APACHE / SYSTEM LOG COLOR CONFIG
# Optimized for high traffic while preserving original style
# ============================================================


# ============================================================
# APACHE IP - beginning of line
# ============================================================

regexp=^\d{1,3}(?:\.\d{1,3}){3}
colours=bold blue
count=once
-


# ============================================================
# EVERYTHING IN []
# Apache timestamp / brackets
# ============================================================

regexp=\[[^]]*\]
colours=cyan
count=once
-


# ============================================================
# RATINGS
# ============================================================

regexp=.+?&rate=.+?
colours=yellow
count=once
-


# ============================================================
# GOOGLEBOT HOSTNAME
#
# Example:
# crawl-66-249-74-131.googlebot.com
#
# Colors:
# crawl-66-249-74-131.googlebot
#
# Leaves:
# .com
#
# IMPORTANT:
# Do NOT use ^.*googlebot.*$
# because that colors the entire Apache line.
# ============================================================

regexp=[A-Za-z0-9.-]+\.googlebot
colours=red
count=once
-


# ============================================================
# GOOGLEBOT USER AGENT
#
# Example:
# Googlebot/2.1
# ============================================================

regexp=Googlebot/[0-9.]+
colours=red
count=once
-


# ============================================================
# GOOGLE PROXY
# ============================================================

regexp=.+google-proxy
colours=red
count=once
-


regexp=^google-proxy
colours=red
count=once
-


regexp=^rate-limited-proxy
colours=red
count=once
-


# ============================================================
# EVERYTHING IN ""
#
# Optimized from:
# \".+?\"
#
# to:
# \"[^\"]*\"
# ============================================================

regexp=\"[^\"]*\"
colours=magenta
count=more
-


# ============================================================
# GET
# ============================================================

regexp=\"GET [^\"]*\"
colours=bold green
count=once
-


# ============================================================
# HEAD
# ============================================================

regexp=\"HEAD [^\"]*\"
colours=green
count=once
-


# ============================================================
# REST API RIHOH
# ============================================================

regexp=/wp-json/custom-api/v1/ricoh-products
colours=bold cyan
count=once
-


# ============================================================
# POST
# ============================================================

regexp=\"POST [^\"]*\"
colours=bold yellow
count=once
-


# ============================================================
# OPTIONAL BOTS
# ============================================================

# regexp=.+?rogerbot.+?
# colours=bold red
# count=more
#-


# regexp=.+?opensiteexplorer.+?
# colours=bold red
# count=more
#-


# ============================================================
# EVERYTHING IN ()
# ============================================================

regexp=\([^)]*\)
colours=green
count=more
-


# ============================================================
# FAIL2BAN BAN
# ============================================================

regexp=.+?Ban.+?
colours=red
count=once
-


# ============================================================
# FAIL2BAN UNBAN
# ============================================================

regexp=.+?Unban.+?
colours=green
count=once
-


# ============================================================
# HTTP METHODS
# ============================================================

regexp=(?:HEAD|PUT|DELETE)
colours=bold blue
count=once
-


# ============================================================
# HTTP METHOD - POST
# ============================================================

# regexp=(?:POST)
# colours=yellow
# count=once
#-


# ============================================================
# HTTP PATH
# ============================================================

# regexp=\s/[^\s]+
# colours=bold green
#-


# ============================================================
# HTTP SUCCESS STATUS
# ============================================================

regexp=\s(?:10[01]|20[02467]|30[0123457])\s
colours=green
count=once
-


# ============================================================
# REQUEST BYTE SIZE
# ============================================================

regexp=\s(?!(?:10[01]|20[02467]|30[0123457])\s|(?:40[1-9]|41[1-8]|42[2-9]|431|444|450|50[2-9]|599)\s)\d+
colours=yellow
count=once
-


# ============================================================
# HTTP REDIRECT
# ============================================================

regexp=\s301\s
colours=bold blue
count=once
-


# ============================================================
# LOG SWITCHING
# ============================================================

regexp=monit\.log
colours=bold blue
count=once
-


regexp=mysql_error\.log
colours=bold red
count=once
-


regexp=access\.log
colours=bold blue
count=once
-


regexp=redis-server\.log
colours=bold blue
count=once
-


regexp=error\.log
colours=bold red
count=once
-


regexp=mail\.log
colours=bold blue
count=once
-


regexp=auth\.log
colours=bold blue
count=once
-


regexp=fail2ban\.log
colours=bold blue
count=once
-


regexp=ufw\.log
colours=bold blue
count=once
-


# ============================================================
# WOOCOMMERCE - CART
# ============================================================

regexp=/cart/
colours=blue
count=more
-


# ============================================================
# ADD TO CART
# ============================================================

regexp=wc-ajax=add_to_cart
colours=bold cyan
count=once
-


# ============================================================
# APPLY COUPON
# ============================================================

regexp=wc-ajax=apply_coupon
colours=bold red
count=once
-


# ============================================================
# ORDER RECEIVED
# ============================================================

regexp=order-received
colours=bold magenta
count=once
-


# ============================================================
# CHECKOUT
# ============================================================

regexp=/checkout/
colours=bold blue
count=more
-


# ============================================================
# ORDER SUCCESS
# ============================================================

regexp=orders&success=true
colours=bold magenta
count=once
-


# ============================================================
# SKROUTZ
# ============================================================

regexp=skroutz
colours=bold red
count=more
-


# ============================================================
# BESTPRICE
# ============================================================

regexp=bestprice
colours=bold red
count=more
-


# ============================================================
# HOTPRICE
# ============================================================

regexp=hotprice
colours=bold red
count=more
-


# ============================================================
# SKROUTZ URL
# ============================================================

regexp=https://www\.skroutz\.gr/
colours=bold red
count=once
-


# ============================================================
# HOTPRICE URL
# ============================================================

regexp=www\.hotprice\.gr
colours=bold red
count=once
-


# ============================================================
# BESTPRICE URL
# ============================================================

regexp=www\.bestprice\.gr
colours=bold red
count=once
-


# ============================================================
# SKROUTZ BOT
# ============================================================

regexp=SkroutzBot
colours=bold red
count=once
-


# ============================================================
# ADWORDS
# ============================================================

regexp=gclid=
colours=bold magenta
count=once
-


# ============================================================
# PRICE FILTER
# ============================================================

regexp=min_price=
colours=bold blue
count=once
-


# ============================================================
# SENT MAIL
# ============================================================

regexp=status=sent
colours=bold green
count=once
-


# ============================================================
# TO MAIL ADDRESS
# ============================================================

regexp=to=<[^>]+>
colours=bold blue
count=once
-


# ============================================================
# MAIL BOUNCED
# ============================================================

regexp=status=bounced
colours=bold yellow
count=once
-


# ============================================================
# IPV6
# ============================================================

regexp=(?:[0-9a-fA-F]{1,4}:){2,7}[0-9a-fA-F]{0,4}
colours=yellow
count=once
-


# ============================================================
# TIME
# ============================================================

# regexp=\s[0-9]{1,6}\s
# colours=yellow
#-


# ============================================================
# TYPE
# ============================================================

# regexp=[A-Z]{1,4}
# colours=cyan
#-


# ============================================================
# IN / CH
# ============================================================

regexp=(IN|CH)
colours=yellow
count=once
-


# ============================================================
# DOMAIN
# ============================================================

# regexp=[a-z0-9-]+\.[a-z0-9]+
# colours=white
#-


# ============================================================
# IP ADDRESS
# ============================================================

regexp=\d{1,3}(?:\.\d{1,3}){3}
colours=white
count=once
-


# ============================================================
# COMMENTS
# ============================================================

regexp=^;;\s\w*\s*\w*
colours=yellow
#-


# ============================================================
# DPT
# ============================================================

regexp=\sDPT=.?\d{1,6}\s
colours=bold red
count=once
-


# ============================================================
# SRC
# ============================================================

regexp=SRC
colours=magenta
count=once
-


# ============================================================
# TCP
# ============================================================

regexp=TCP
colours=bold green
count=once
-


# ============================================================
# ICMP
# ============================================================

regexp=PROTO=ICMP
colours=bold red
count=once
-


# ============================================================
# UDP
# ============================================================

regexp=UDP
colours=bold green
count=once
-


# ============================================================
# DOMAIN/IP ALTERNATIVE
# ============================================================

# regexp=[a-z0-9-]+\.[a-z0-9]+\.[a-z0-9-]+\.[a-z0-9]+
# colours=bold yellow
#-


# ============================================================
# UFW ALLOW
# ============================================================

regexp=\[UFW ALLOW\]
colours=green
count=once
-


# ============================================================
# UFW BLOCK
# ============================================================

regexp=\[UFW BLOCK\]
colours=red
count=once
-


# ============================================================
# UFW AUDIT
# ============================================================

regexp=\[UFW AUDIT\]
colours=bold blue
count=once
-


# ============================================================
# SRC IP
# ============================================================

regexp=SRC=\d{1,3}(?:\.\d{1,3}){3}
colours=yellow
count=once
-


# ============================================================
# BY IP
# ============================================================

regexp=by ip
colours=bold yellow
count=once
-


# ============================================================
# LINKOUT
# ============================================================
regexp=.+?linkout.+?
colours=bold magenta
count=once
-


# ============================================================
# SUSPICIOUS PHP
# ============================================================

regexp=/nou/meow\.php
colours=bold yellow
count=once
-


# ============================================================
# FEED
# ============================================================

regexp=/feed/
colours=blue
count=once
-


# ============================================================
# HTTP ERRORS
# ============================================================

regexp=\s(?:40[1-35-9]|41[0-8]|42[2-9]|431|444|450|50[2-9]|599)\s
colours=bold red
count=once
-


# ============================================================
# 404
# ============================================================

regexp=\s404\s
colours=bold red
count=once
-

# ============================================================
# AI SEARCH / USER-REQUESTED AGENTS
# OpenAI, Anthropic and Perplexity
# ============================================================

regexp=(?:OAI-SearchBot|ChatGPT-User|Claude-SearchBot|Claude-User|PerplexityBot|Perplexity-User)(?:/[0-9.]+)?
colours=bold cyan
count=once
-


# ============================================================
# OPENAI AGENT REFERENCE URL
# Helps identify full OpenAI crawler User-Agent strings.
# ============================================================

regexp=(?:https?://)?(?:www\.)?openai\.com/(?:searchbot|bot|gptbot)
colours=bold cyan
count=once
-


# ============================================================
# AI TRAINING / DATA-COLLECTION AGENTS
# These may be allowed or blocked; they remain identifiable in either case.
# ============================================================

regexp=(?:GPTBot|ClaudeBot|meta-externalagent|Meta-ExternalFetcher|Amazonbot|Bytespider|CCBot|cohere-ai|anthropic-ai)(?:/[0-9.]+)?
colours=bold yellow
count=once
-


# ============================================================
# GOOGLE AI-RELATED CRAWLERS
# Googlebot itself is already coloured by your existing Googlebot rules.
# Google-Extended is normally a robots.txt token rather than an HTTP UA, but
# including it here is harmless and makes unusual log entries recognizable.
# ============================================================

regexp=(?:GoogleOther|Google-Extended|Google-CloudVertexBot)(?:/[0-9.]+)?
colours=bold cyan
count=once
-


# ============================================================
# MICROSOFT AI DISCOVERY
# Copilot normally relies on Bing's established crawling infrastructure.
# ============================================================

# regexp=(?:bingbot|BingPreview|adidxbot)(?:/[0-9.]+)?
# colours=bold cyan
# count=more
# -


# ============================================================
# APPLE AI-RELATED CRAWLING
# ============================================================

# regexp=(?:Applebot|Applebot-Extended)(?:/[0-9.]+)?
# colours=bold cyan
# count=once
# -

# PROSFORES
regexp=(?:prosfores)(?:/[0-9.]+)?
colours=bold cyan
count=once
-


# BEGIN GOOGLE IP RANGES (generated)
# Generated from /etc/modsecurity/google_ips.txt by fetch_google_ip_ranges.sh.
# All Google ranges, including Cloud; these do not identify Googlebot alone.
# Full IPv4 and IPv6 addresses; last rules override earlier IP colours.
# Refreshed automatically by the existing fetch cron job.

regexp=(?<![0-9A-Za-z_.:])(?:8\.8\.4\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|8\.8\.8\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|8\.34\.2(?:0[89]|1[0123456789]|2[0123])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|8\.35\.(?:19[23456789]|20[01234567])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|8\.2(?:2[89]|3[01])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|8\.23[2345]\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|8\.23[67]\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|23\.236\.(?:4[89]|5[0123456789]|6[0123])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|23\.251\.1(?:2[89]|[345][0123456789])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.[01]\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.2\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.3\.[01]\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.3\.3\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.3\.4\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.3\.(?:[89]|1[012345])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.3\.(?:1[6789]|2[0123456789]|3[01])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.3\.(?:3[23456789]|[45][0123456789]|6[0123])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.3\.(?:(?:6[456789]|[789][0123456789])|1(?:[01][0123456789]|2[01234567]))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.[4567]\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.(?:[89]|1[012345])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.(?:1[6789]|2[0123456789]|3[01])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.(?:3[23456789]|[45][0123456789]|6[0123])\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))\.(?:[0123456789]|[123456789][0123456789]|(?:1[0123456789][0123456789]|2(?:[01234][0123456789]|5[012345])))|34\.(?:(?:6[456789]|[789][0123456789])|1(?:[01][0123456789]|2[01234567]))\.(?:[0123456789]